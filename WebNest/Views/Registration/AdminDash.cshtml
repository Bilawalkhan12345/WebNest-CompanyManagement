@model WebNest.Models.Registration

@{
    ViewData["Title"] = "WebNest Admin";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">

<style>
    :root {
        --primary-blue: #1E3A8A;
        --primary-indigo: #3B5BDB;
        --primary-purple: #7C3AED;
        --accent-blue-light: #60A5FA;
        --white: #FFFFFF;
        --light-gray: #F5F5F5;
        --text-dark: #1F2937;
        --gradient-main: linear-gradient(90deg, #1E3A8A, #3B5BDB, #7C3AED);
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: var(--gradient-main);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-container {
        background: white;
        padding: 40px;
        border-radius: 20px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }

    h2 {
        font-weight: 700;
        color: var(--primary-indigo);
    }

    label {
        font-weight: 600;
        margin-bottom: 5px;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px;
    }

    .btn-main {
        background: var(--gradient-main);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 10px;
        font-weight: 600;
        width: 100%;
        transition: 0.3s;
    }

        .btn-main:hover {
            background: var(--primary-purple);
        }

    .form-container {
        max-width: 900px; /* instead of 450px */
    }

</style>

<div class="form-container animate__animated animate__fadeInDown">


    <form asp-controller="Registration" asp-action="Add" method="post">

        <!-- ROW 1 -->
        <div class="row">
            <div class="col-md-4 mb-3">
                <label>Client Name</label>
                <input asp-for="ClientName" class="form-control" />
            </div> 

           
            <div class="col-md-4 mb-3">
                <label>Phone</label>
                <input asp-for="Phone" class="form-control" />  
            </div>

            <div class="col-md-4 mb-3">
                <label>City</label>
                <input asp-for="City" class="form-control" />
            </div>

        </div>

        <!-- ROW 2 -->
        <div class="row">
            

            <div class="col-md-4 mb-3">
                <label>Address</label>
                <input asp-for="Address" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label>Company Name</label>
                <input asp-for="CompanyName" class="form-control" />
            </div>

                <div class="col-md-4 mb-3">
                <label>Company Type</label>
                <select asp-for="CompanyType" class="form-control">
                    <option value="">-- Select Company Type --</option>

                    <option value="IT">IT (Software / Tech)</option>
                    <option value="E-commerce">E-commerce</option>
                    <option value="Education">Education</option>
                    <option value="Healthcare">Healthcare</option>
                    <option value="Finance">Finance / Banking</option>
                    <option value="Manufacturing">Manufacturing</option>
                    <option value="Retail">Retail / Shopping</option>
                    <option value="Real Estate">Real Estate</option>
                    <option value="Construction">Construction</option>
                    <option value="Agricultural">Agricultural</option>
                    <option value="Industrial">Industrial</option>
                    <option value="Transport">Transport / Logistics</option>
                    <option value="Media">Media / Marketing</option>
                    <option value="Government">Government</option>
                    <option value="Other">Other</option>
                </select>
            </div>

        </div>

        <!-- ROW 3 -->
        <div class="row">
        

            <div class="col-md-4 mb-3">
                <label>Employees</label>
                <input asp-for="Employees" class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label>User ID</label>
                <input asp-for="UserId" class="form-control" />
            </div>
        </div>

        <!-- ROW 4 -->
@*         <div class="row">
            <div class="col-md-6 mb-3">
                <label>Password</label>
                <input asp-for="Password" type="password" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label>Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
            </div>
        </div> *@

        <button type="submit" class="btn-main mt-2">Create Company</button>
        


    </form>
    

    <div class="small-text text-center">

        <a asp-controller="Login" asp-action="AdminLogin"
               class="text-decoration-none fw-semibold"
               style="color:#1E3A8A;">
            Logout
        </a>

    </div>

    <br />
    
    <div class="small-text text-center">
        <a href="/Home/Index"
               class="text-decoration-none fw-semibold"
               style="color:#1E3A8A;">
            Go to Home page
        </a>
    </div>

</div>



<!-- Toast Notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true" data-bs-delay="3000">
        <div class="d-flex">
            <div class="toast-body">
                ✅ User added successfully!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        @if (TempData["SuccessMessage"] != null)
        {
                    <text>
                            var toastEl = document.getElementById('successToast');
                            var toast = new bootstrap.Toast(toastEl, {
                                autohide: true,
                                delay: 3000
                            });
                            toast.show();
                    </text>
        }
    </script>

}


