@model IEnumerable<WebNest.Models.Registration>

@{
    ViewData["Title"] = "WebNest Admin";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">

<style>
    :root {
        --primary-blue: #1E3A8A;
        --primary-indigo: #3B5BDB;
        --primary-purple: #7C3AED;
        --white: #fff;
        --gray: #f3f4f6;
        --text: #1f2937;
        --border: #e5e7eb;
    }

    body {
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(90deg, #1E3A8A, #3B5BDB, #7C3AED);
        min-height: 100vh;
        margin: 0;
        padding: 30px;
        color: var(--text);
    }

    .stats-row { display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap; }

    .stat-card {
        background: white; padding: 25px; border-radius: 18px;
        min-width: 220px; box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    }

    .stat-number { font-size: 32px; font-weight: bold; color: var(--primary-indigo); }
    .stat-label  { margin-top: 5px; color: #666; font-weight: 600; }

    .search-bar { margin-bottom: 25px; }
    .search-bar input {
        width: 100%; max-width: 450px; padding: 14px 18px;
        border-radius: 12px; border: none; outline: none;
        font-size: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .users-container { display: flex; flex-direction: column; gap: 20px; }

    .user-card {
        background: white; border-radius: 18px;
        overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    }

    .user-header {
        padding: 20px; display: flex; justify-content: space-between;
        align-items: center; cursor: pointer; background: white;
    }

    .user-header-left { display: flex; align-items: center; gap: 15px; }

    .user-avatar {
        width: 55px; height: 55px; border-radius: 50%;
        background: linear-gradient(135deg, #3B5BDB, #7C3AED);
        color: white; display: flex; align-items: center;
        justify-content: center; font-weight: bold; font-size: 18px;
    }

    .user-name  { font-size: 18px; font-weight: 700; }
    .user-email { color: #666; font-size: 14px; }

    .user-header-right { display: flex; align-items: center; gap: 12px; }

    .company-badge {
        background: #eef2ff; color: #4338ca;
        padding: 6px 12px; border-radius: 20px;
        font-size: 13px; font-weight: 600;
    }

    .btn-delete-user, .btn-edit-company, .btn-delete-company {
        border: none; padding: 8px 14px;
        border-radius: 10px; font-weight: 600; cursor: pointer;
    }

    .btn-delete-user, .btn-delete-company { background: #ef4444; color: white; }
    .btn-edit-company { background: #3B82F6; color: white; }

    .user-body { display: none; border-top: 1px solid var(--border); background: #fafafa; }
    .user-body-inner { padding: 20px; }

    .company-slot {
        background: white; border-radius: 14px;
        margin-bottom: 15px; border: 1px solid var(--border); overflow: hidden;
    }

    .company-slot-header {
        padding: 16px 20px; display: flex;
        justify-content: space-between; align-items: center; cursor: pointer;
    }

    .company-slot-left { display: flex; align-items: center; gap: 10px; }

    .company-dot { width: 12px; height: 12px; border-radius: 50%; background: #7C3AED; }
    .company-slot-name { font-weight: 700; }

    .company-slot-type {
        background: #ede9fe; color: #6d28d9;
        padding: 4px 10px; border-radius: 20px; font-size: 12px;
    }

    .company-slot-right { display: flex; align-items: center; gap: 10px; }

    .company-body {
        display: none; padding: 20px;
        border-top: 1px solid var(--border); background: #fafafa;
    }

    .detail-row {
        display: flex; justify-content: space-between;
        padding: 10px 0; border-bottom: 1px solid #eee;
    }

    .detail-label { font-weight: 700; color: #555; }
    .detail-value { color: #111; }

    .empty-state { background: white; padding: 40px; border-radius: 20px; text-align: center; }
    .arrow-icon, .company-arrow { font-size: 18px; }

    /* ── Confirm Modal ── */
    .confirm-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.5); z-index: 10000;
        align-items: center; justify-content: center;
    }

    .confirm-box {
        background: white; border-radius: 18px; padding: 32px 28px;
        width: 90%; max-width: 420px; text-align: center;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    }

    .confirm-icon { font-size: 42px; margin-bottom: 12px; }

    .confirm-title {
        font-size: 20px; font-weight: 700;
        color: #1E3A8A; margin-bottom: 8px;
    }

    .confirm-message { color: #555; font-size: 15px; margin-bottom: 24px; line-height: 1.5; }

    .confirm-name {
        font-weight: 700; color: #1E3A8A;
        background: #eef2ff; padding: 2px 10px;
        border-radius: 8px; display: inline-block; margin-bottom: 16px;
    }

    .confirm-btns { display: flex; gap: 12px; justify-content: center; }

    .confirm-btns button {
        padding: 10px 28px; border-radius: 10px;
        font-weight: 600; font-size: 15px; cursor: pointer; border: none;
    }

    .btn-cancel-confirm { background: #f3f4f6; color: #333; }
    .btn-confirm-action { background: #ef4444; color: white; }
    .btn-confirm-save   { background: #3B82F6; color: white; }






    .admin-slot-logo {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    object-fit: cover;
    border: 2px solid #e0e7ff;
    flex-shrink: 0;
    background: linear-gradient(135deg, #3B5BDB, #7C3AED);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    overflow: hidden;
}

.admin-slot-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}




</style>

<nav>
    <div style="max-width:1200px; margin:auto; display:flex; align-items:center; justify-content:flex-end; padding:0 20px;">
        <div style="display:flex; gap:10px; align-items:center;">
            <a href="/Login/AdminLogin"
               style="background:#D1D5DB; color:#1E3A8A; padding:6px 14px;
                      border-radius:8px; text-decoration:none; font-weight:600;">
                Logout
            </a>
        </div>
    </div>
</nav>

@{
    var users     = ViewBag.Users     as List<WebNest.Models.Signup>;
    var companies = ViewBag.Companies as List<WebNest.Models.Registration>;
    int totalUsers     = users?.Count     ?? 0;
    int totalCompanies = companies?.Count ?? 0;
}

<!-- Stats -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-number">@totalUsers</div>
        <div class="stat-label">Total Users</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@totalCompanies</div>
        <div class="stat-label">Total Companies</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">5</div>
        <div class="stat-label">Max Per User</div>
    </div>
</div>

<!-- Search -->
<div class="search-bar">
    <input type="text" id="searchInput"
           placeholder="Search by name, email, company..."
           onkeyup="filterUsers()" />
</div>

@{
    int uCount = 1;
}

@if (users != null && users.Any())
{
    <div class="users-container" id="usersContainer">
        @foreach (var user in users)
        {
            var userCompanies = companies?
                .Where(c => c.LoggedInUserId == user.Id)
                .ToList() ?? new List<WebNest.Models.Registration>();

            int compCount = userCompanies.Count;
            string firstName = user.FirstName ?? "?";
            string lastName  = user.LastName  ?? "?";
            string initials  = firstName.Substring(0,1).ToUpper()
                             + lastName.Substring(0,1).ToUpper();
            string fullName  = user.FirstName + " " + user.LastName;

            <div class="user-card" data-search="@user.FirstName @user.LastName @user.Email">

                <div class="user-header" onclick="toggleUser(@uCount)">
                    <div class="user-header-left">
                        <div class="user-avatar">@initials</div>
                        <div>
                            <div class="user-name">@user.FirstName @user.LastName</div>
                            <div class="user-email">@user.Email</div>
                        </div>
                    </div>
                    <div class="user-header-right">
                        <span class="company-badge">@compCount / 5 companies</span>
                        <button type="button" class="btn-delete-user"
                                onclick="event.stopPropagation();
                                         showDeleteUser(@user.Id, '@fullName')">
                            Delete User
                        </button>
                        <span class="arrow-icon" id="user-arrow-@uCount">&#9662;</span>
                    </div>
                </div>

                <div class="user-body" id="user-body-@uCount">
                    <div class="user-body-inner">
                        @if (!userCompanies.Any())
                        {
                            <div class="no-companies">No companies added yet.</div>
                        }
                        else
                        {
                            int cCount = 1;
                            foreach (var comp in userCompanies)
                            {
                                <div class="company-slot">
                                    <div class="company-slot-header"
                                         onclick="toggleCompany('@(uCount)-@(cCount)')">
                                        

   

                                         <div class="company-slot-left">
                                              <div class="company-dot"></div>
                                              <div class="admin-slot-logo" id="admin-logo-@comp.RegId">🏢</div>
                                              <span class="company-slot-name">@comp.CompanyName</span>
                                              <span class="company-slot-type">@comp.CompanyType</span>
                                         </div>





                                            <span class="arrow-icon" id="user-arrow-@uCount">&#9662;</span>
                                        </div>
                                    </div>

                                    <div class="company-body" id="comp-body-@(uCount)-@(cCount)">
                                        <div class="detail-row">
                                            <span class="detail-label">Client Name</span>
                                            <span class="detail-value">@comp.ClientName</span>
                                        </div>

                                        <div class="detail-row">
                                            <span class="detail-label">Phone</span>
                                            <span class="detail-value">@comp.Phone</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="detail-label">Address</span>
                                            <span class="detail-value">@comp.Address</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="detail-label">City</span>
                                            <span class="detail-value">@comp.City</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="detail-label">Company Type</span>
                                            <span class="detail-value">@comp.CompanyType</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="detail-label">Employees</span>
                                            <span class="detail-value">@comp.Employees</span>
                                        </div>
                                        <div class="detail-row">
                                            <span class="detail-label">User ID</span>
                                            <span class="detail-value">@comp.UserId</span>
                                        </div>
                                    </div>

                                cCount++;
                            }
                        }
                    </div>
                </div>
            </div>
            uCount++;
        }
    </div>
}
else
{
    <div class="empty-state">
        <h3>No users registered yet.</h3>
    </div>
}




<!-- ═══════════════════════════════════════
     DELETE USER CONFIRM MODAL
════════════════════════════════════════ -->
<div id="deleteUserModal" class="confirm-overlay">
    <div class="confirm-box">
        <div class="confirm-icon">🗑️</div>
        <div class="confirm-title">Delete User?</div>
        <div class="confirm-message">
            You are about to permanently delete:
        </div>
        <div class="confirm-name" id="deleteUserName"></div>
        <div class="confirm-message">
            This will also delete <strong>all their companies</strong>. This cannot be undone.
        </div>
        <div class="confirm-btns">
            <button class="btn-cancel-confirm" onclick="closeModal('deleteUserModal')">Cancel</button>
            <button class="btn-confirm-action" onclick="submitDeleteUser()">Yes, Delete</button>
        </div>
    </div>
</div>




<!-- ═══════════════════════════════════════
     SAVE CHANGES CONFIRM MODAL
════════════════════════════════════════ -->
<div id="saveConfirmModal" class="confirm-overlay">
    <div class="confirm-box">
        <div class="confirm-icon">💾</div>
        <div class="confirm-title">Save Changes?</div>
        <div class="confirm-message">
            You are about to update the details for:
        </div>
        <div class="confirm-name" id="saveCompanyName"></div>
        <div class="confirm-message">Are you sure you want to save these changes?</div>
        <div class="confirm-btns">
            <button class="btn-cancel-confirm" onclick="closeModal('saveConfirmModal')">Cancel</button>
            <button class="btn-confirm-save"   onclick="submitSave()">Yes, Save</button>
        </div>
    </div>
</div>


<!-- Hidden forms -->
<form id="deleteUserForm"    method="post" action="/Registration/DeleteSignupUser" style="display:none;">
    <input type="hidden" id="deleteUserId" name="id" />
</form>
<form id="deleteCompanyForm" method="post" action="/Registration/DeleteCompany"    style="display:none;">
    <input type="hidden" id="deleteCompanyId" name="id" />
</form>
<form id="saveForm" method="post" action="/Registration/UpdateUser" style="display:none;">
    <input type="hidden" name="RegId"       id="sf-regid" />
    <input type="hidden" name="ClientName"  id="sf-clientname" />
    <input type="hidden" name="Phone"       id="sf-phone" />
    <input type="hidden" name="Address"     id="sf-address" />
    <input type="hidden" name="City"        id="sf-city" />
    <input type="hidden" name="CompanyName" id="sf-companyname" />
    <input type="hidden" name="CompanyType" id="sf-companytype" />
    <input type="hidden" name="Employees"   id="sf-employees" />
    <input type="hidden" name="UserId"      id="sf-userid" />
</form>


@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>




    // Load company logos from localStorage (saved by user dashboard)
(function loadAdminLogos() {
    try {
        const saved = localStorage.getItem('webnest_logos');
        if (!saved) return;
        const map = JSON.parse(saved);
        Object.keys(map).forEach(regId => {
            const el = document.getElementById('admin-logo-' + regId);
            if (!el) return;
            el.innerHTML = `<img src="${map[regId]}" alt="Logo">`;
            el.style.background = 'transparent';
        });
    } catch(e) {}
})();





    /* ── Toggle expand/collapse ── */
    function toggleUser(id) {
        const body = document.getElementById("user-body-" + id);
        body.style.display = (body.style.display === "block") ? "none" : "block";
    }

    function toggleCompany(id) {
        const body = document.getElementById("comp-body-" + id);
        body.style.display = (body.style.display === "block") ? "none" : "block";
    }

    /* ── Search ── */
    function filterUsers() {
        const input = document.getElementById("searchInput").value.toLowerCase();
        document.querySelectorAll(".user-card").forEach(card => {
            card.style.display =
                card.getAttribute("data-search").toLowerCase().includes(input)
                    ? "block" : "none";
        });
    }

    /* ── Modal helpers ── */
    function openModal(id)  { document.getElementById(id).style.display = "flex"; }
    function closeModal(id) { document.getElementById(id).style.display = "none"; }

    // close any modal by clicking its dark backdrop
    document.querySelectorAll(".confirm-overlay").forEach(overlay => {
        overlay.addEventListener("click", function(e) {
            if (e.target === this) closeModal(this.id);
        });
    });

    /* ════════════════════════════
       DELETE USER
    ════════════════════════════ */
    function showDeleteUser(userId, userName) {
        document.getElementById("deleteUserId").value   = userId;
        document.getElementById("deleteUserName").textContent = userName;
        openModal("deleteUserModal");
    }

    function submitDeleteUser() {
        document.getElementById("deleteUserForm").submit();
    }

    /* ════════════════════════════
       DELETE COMPANY
    ════════════════════════════ */
    function showDeleteCompany(companyId, companyName) {
        document.getElementById("deleteCompanyId").value          = companyId;
        document.getElementById("deleteCompanyName").textContent  = companyName;
        openModal("deleteCompanyModal");
    }

    function submitDeleteCompany() {
        document.getElementById("deleteCompanyForm").submit();
    }


    function submitSave() {
        document.getElementById("saveForm").submit();
    }

</script>
}