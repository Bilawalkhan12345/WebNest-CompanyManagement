<script>
const logoStore = {};
let pendingAddLogo   = null;
let currentEditRegId = null;

// On page load: restore logos saved before last reload
(function restoreLogos() {
    const saved = localStorage.getItem('webnest_logos');
    if (!saved) return;
    try {
        const map = JSON.parse(saved);
        const cleaned = {};

        Object.keys(map).forEach(key => {
            if (key.startsWith('__pending__')) {
                // Match by company name shown in slot titles
                const cName = key.replace('__pending__', '');
                document.querySelectorAll('.slot-title').forEach(el => {
                    if (el.textContent.trim() === cName) {
                        // Find the slot-logo id from sibling
                        const header = el.closest('.slot-header');
                        if (!header) return;
                        const logoWrap = header.querySelector('[id^="slot-logo-"]');
                        if (!logoWrap) return;
                        const regId = logoWrap.id.replace('slot-logo-', '');
                        logoStore[regId] = map[key];
                        cleaned[regId]   = map[key];
                        applyLogoToSlot(regId, map[key]);
                    }
                });
            } else {
                logoStore[key] = map[key];
                cleaned[key]   = map[key];
                applyLogoToSlot(key, map[key]);
            }
        });

        localStorage.setItem('webnest_logos', JSON.stringify(cleaned));
    } catch(e) {}
})();



function persistLogoStore() {
    localStorage.setItem('webnest_logos', JSON.stringify(logoStore));
}

function handleLogoUpload(context, input) {
    const file = input.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) { alert('Image must be smaller than 2 MB.'); input.value = ''; return; }
    const reader = new FileReader();
    reader.onload = function(e) {
        const dataUrl = e.target.result;
        document.getElementById(context + '-logo-placeholder').style.display = 'none';
        document.getElementById(context + '-logo-preview-wrap').classList.add('visible');
        document.getElementById(context + '-logo-preview-img').src = dataUrl;
        document.getElementById(context + '-logo-filename').textContent = file.name;
        if (context === 'add') {
            pendingAddLogo = dataUrl;
        } else if (context === 'edit' && currentEditRegId !== null) {
            logoStore[String(currentEditRegId)] = dataUrl;
            applyLogoToSlot(currentEditRegId, dataUrl);
        }
    };
    reader.readAsDataURL(file);
}

function removeLogo(context) {
    document.getElementById(context + '-logo-placeholder').style.display = '';
    document.getElementById(context + '-logo-preview-wrap').classList.remove('visible');
    document.getElementById(context + '-logo-preview-img').src = '';
    const inp = document.getElementById(context + '-logo-input');
    if (inp) inp.value = '';
    if (context === 'add') {
        pendingAddLogo = null;
    } else if (context === 'edit' && currentEditRegId !== null) {
        delete logoStore[String(currentEditRegId)];
        clearLogoFromSlot(currentEditRegId);
    }
}

function applyLogoToSlot(regId, dataUrl) {
    const id = String(regId);
    const wrap = document.getElementById('slot-logo-' + id);
    if (wrap) {
        wrap.innerHTML = `<img src="${dataUrl}" alt="Logo" style="width:100%;height:100%;object-fit:cover;border-radius:8px;">`;
        wrap.style.background = 'transparent';
    }
    const expandedImg = document.getElementById('slot-logo-expanded-' + id);
    const expandedRow = document.getElementById('slot-logo-row-' + id);
    if (expandedImg && expandedRow) {
        expandedImg.src = dataUrl;
        expandedRow.style.display = 'flex';
    }
        persistLogoStore();
}

function clearLogoFromSlot(regId) {
    const id = String(regId);
    const wrap = document.getElementById('slot-logo-' + id);
    if (wrap) { wrap.innerHTML = '🏢'; wrap.style.background = 'var(--gradient-main)'; }
    const expandedRow = document.getElementById('slot-logo-row-' + id);
    if (expandedRow) expandedRow.style.display = 'none';
    persistLogoStore(); 
}

function loadEditLogoPreview(regId) {
    const dataUrl = logoStore[String(regId)];
    const placeholder = document.getElementById('edit-logo-placeholder');
    const wrap        = document.getElementById('edit-logo-preview-wrap');
    const img         = document.getElementById('edit-logo-preview-img');
    const fname       = document.getElementById('edit-logo-filename');
    if (dataUrl) {
        placeholder.style.display = 'none';
        wrap.classList.add('visible');
        img.src = dataUrl;
        fname.textContent = 'current-logo.png';
    } else {
        placeholder.style.display = '';
        wrap.classList.remove('visible');
        img.src = '';
        document.getElementById('edit-logo-input').value = '';
    }
}

async function printCompanyPDF(regId, companyName, companyType, clientName, phone, address, city, employees, userId) {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const W = 210, m = 20, cW = 170;
    const navy=[30,58,138], indigo=[59,91,219], purple=[124,58,237];
    const white=[255,255,255], light=[238,242,255], grey=[100,116,139];
    const dark=[15,23,42], border=[203,213,225];

    doc.setFillColor(...navy);   doc.rect(0, 0, W, 52, 'F');
    doc.setFillColor(...indigo); doc.rect(0, 44, W, 8, 'F');
    doc.setFillColor(...purple); doc.triangle(W-60, 0, W, 0, W, 60, 'F');

    const logoDataUrl = logoStore[String(regId)] || null;
    if (logoDataUrl) {
        try {
            let fmt = 'JPEG';
            if (logoDataUrl.includes('image/png')) fmt = 'PNG';
            doc.setFillColor(...white);
            doc.roundedRect(m, 8, 32, 32, 4, 4, 'F');
            doc.addImage(logoDataUrl, fmt, m+1, 9, 30, 30);
        } catch(e) {
            doc.setFillColor(...light);
            doc.roundedRect(m, 8, 32, 32, 4, 4, 'F');
        }
    } else {
        doc.setFillColor(...light);
        doc.roundedRect(m, 8, 32, 32, 4, 4, 'F');
    }

    doc.setTextColor(...white);
    doc.setFontSize(20); doc.setFont('helvetica','bold');
    doc.text(companyName, m+38, 22);
    doc.setFontSize(10); doc.setFont('helvetica','normal');
    doc.setTextColor(199,210,254);
    doc.text(companyType + '  •  ' + city, m+38, 30);
    doc.setFontSize(7); doc.setFont('helvetica','bold');
    doc.setTextColor(167,139,250);
    doc.text('COMPANY PROFILE', W-m-1, 10, { align:'right' });
    doc.setFont('helvetica','normal');
    const now = new Date();
    doc.text('Generated: ' + now.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'}), W-m-1, 16, { align:'right' });

    let y = 60;

    function drawSection(title, rows) {
        doc.setFillColor(...light);
        doc.roundedRect(m, y, cW, 9, 2, 2, 'F');
        doc.setDrawColor(...indigo); doc.setLineWidth(0.4);
        doc.roundedRect(m, y, cW, 9, 2, 2, 'S');
        doc.setFontSize(9); doc.setFont('helvetica','bold'); doc.setTextColor(...navy);
        doc.text(title, m+4, y+6);
        y += 14;
        rows.forEach((row, i) => {
            const ry = y + i * 14;
            if (i % 2 === 0) { doc.setFillColor(248,250,252); doc.rect(m, ry-1, cW, 13, 'F'); }
            doc.setDrawColor(...border); doc.setLineWidth(0.2);
            doc.line(m, ry+12, m+cW, ry+12);
            doc.setFontSize(8); doc.setFont('helvetica','normal'); doc.setTextColor(...grey);
            doc.text(row[0], m+4, ry+7);
            doc.setFont('helvetica','bold'); doc.setTextColor(...dark);
            const val = String(row[1]||'—');
            doc.text(val.length>30 ? val.substring(0,30)+'…' : val, m+cW-4, ry+7, { align:'right' });
        });
        y += rows.length * 14 + 8;
    }

    drawSection('COMPANY INFORMATION', [
        ['Company Name', companyName],
        ['Company Type', companyType],
        ['City',         city],
        ['Address',      address],
    ]);

    drawSection('CLIENT DETAILS', [
        ['Client Name', clientName],
        ['Phone',       phone],
        ['Employees',   employees],
        ['User ID',     userId],
    ]);

    const boxW = (cW - 10) / 3;
    [['Employees',employees],['Industry',companyType],['Location',city]].forEach((s,i) => {
    const bx = m + i*(boxW+5);
    doc.setFillColor(...light); doc.setDrawColor(...border); doc.setLineWidth(0.3);
    doc.roundedRect(bx, y, boxW, 22, 3, 3, 'FD');

    // Coloured left accent bar
    doc.setFillColor(...indigo);
    doc.roundedRect(bx, y, 3, 22, 1, 1, 'F');

    doc.setFontSize(7); doc.setFont('helvetica','normal'); doc.setTextColor(...grey);
    doc.text(s[0].toUpperCase(), bx+7, y+8);
    doc.setFontSize(9); doc.setFont('helvetica','bold'); doc.setTextColor(...navy);
    const v = String(s[1]||'—');
    doc.text(v.length>16 ? v.substring(0,16)+'…' : v, bx+7, y+16);
});

    doc.setDrawColor(...border); doc.setLineWidth(0.3); doc.line(m, 277, W-m, 277);
    doc.setFontSize(8); doc.setFont('helvetica','bold'); doc.setTextColor(...navy);
    doc.text('WebNest', m, 284);
    doc.setFont('helvetica','normal'); doc.setFontSize(7); doc.setTextColor(...grey);
    doc.text('Company Management Platform', m, 289);
    doc.text('Page 1 of 1', W-m, 284, { align:'right' });
    doc.setFillColor(...navy);   doc.rect(0, 292, W/3, 5, 'F');
    doc.setFillColor(...indigo); doc.rect(W/3, 292, W/3, 5, 'F');
    doc.setFillColor(...purple); doc.rect((W/3)*2, 292, W/3, 5, 'F');

    doc.save(companyName.replace(/[^a-z0-9]/gi,'_') + '_Company_Details.pdf');
}

function toggleSlot(index) {
    const body  = document.getElementById('body-'  + index);
    const arrow = document.getElementById('arrow-' + index);
    const isOpen = body.classList.contains('open');
    document.querySelectorAll('.slot-body').forEach(b  => b.classList.remove('open'));
    document.querySelectorAll('.slot-arrow').forEach(a => a.classList.remove('open'));
    if (!isOpen) { body.classList.add('open'); arrow.classList.add('open'); }
}

function openModal(id)  { document.getElementById(id).style.display = "flex"; }
function closeModal(id) { document.getElementById(id).style.display = "none"; }
document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', function(e) { if (e.target === this) closeModal(this.id); });
});

function openEdit(regId, clientName, phone, address, city, companyName, companyType, employees, userId) {
    currentEditRegId = regId;
    document.getElementById('edit-regid').value       = regId;
    document.getElementById('edit-clientname').value  = clientName;
    document.getElementById('edit-phone').value       = phone;
    document.getElementById('edit-address').value     = address;
    document.getElementById('edit-city').value        = city;
    document.getElementById('edit-companyname').value = companyName;
    document.getElementById('edit-companytype').value = companyType;
    document.getElementById('edit-employees').value   = employees;
    document.getElementById('edit-userid').value      = userId;
    document.getElementById('edit-subtitle').textContent = 'Editing: ' + companyName;
    loadEditLogoPreview(regId);
    openModal('editModal');
}

function confirmSave(e) {
    e.preventDefault();
    const name = document.getElementById('edit-companyname').value;
    document.getElementById('save-company-name').textContent = name;
    document.getElementById('sf-regid').value       = document.getElementById('edit-regid').value;
    document.getElementById('sf-clientname').value  = document.getElementById('edit-clientname').value;
    document.getElementById('sf-phone').value       = document.getElementById('edit-phone').value;
    document.getElementById('sf-address').value     = document.getElementById('edit-address').value;
    document.getElementById('sf-city').value        = document.getElementById('edit-city').value;
    document.getElementById('sf-companyname').value = name;
    document.getElementById('sf-companytype').value = document.getElementById('edit-companytype').value;
    document.getElementById('sf-employees').value   = document.getElementById('edit-employees').value;
    document.getElementById('sf-userid').value      = document.getElementById('edit-userid').value;
    closeModal('editModal'); openModal('saveModal'); return false;
}
function submitSave() { document.getElementById('saveForm').submit(); }

function showDelete(id, name) {
    document.getElementById('delete-id').value = id;
    document.getElementById('delete-company-name').textContent = name;
    openModal('deleteModal');
}
function submitDelete() { document.getElementById('deleteForm').submit(); }

