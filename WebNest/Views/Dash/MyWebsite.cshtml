<!-- ═══════════════════════════════════
     EDIT MODAL
════════════════════════════════════ -->
<div id="editModal" class="modal-overlay">
    <div class="edit-modal-box">
        <h3 style="color:#1E3A8A; margin-bottom:4px;">Edit Company</h3>
        <p id="edit-subtitle" style="color:#888; font-size:13px; margin-bottom:20px;"></p>

        <form method="post" action="/Dash/UpdateCompany" onsubmit="return confirmSave(event)">
            <input type="hidden" id="edit-regid"   name="RegId" />
            <input type="hidden" id="edit-userid"  name="UserId" />

            <div style="display:grid; gap:14px;">
                <div class="edit-field">
                    <label>Client Name</label>
                    <input type="text"  id="edit-clientname"  name="ClientName" />
                </div>
               
                <div class="edit-field">
                    <label>Phone</label>
                    <input type="text"  id="edit-phone"       name="Phone" />
                </div>
                <div class="edit-field">
                    <label>Address</label>
                    <input type="text"  id="edit-address"     name="Address" />
                </div>
                <div class="edit-field">
                    <label>City</label>
                    <input type="text"  id="edit-city"        name="City" />
                </div>
                <div class="edit-field">
                    <label>Company Name</label>
                    <input type="text"  id="edit-companyname" name="CompanyName" />
                </div>
                <div class="edit-field">
                    <label>Company Type</label>
                    <input type="text"  id="edit-companytype" name="CompanyType" />
                </div>
                <div class="edit-field">
                    <label>Employees</label>
                    <input type="text"  id="edit-employees"   name="Employees" />
                </div>
            </div>

            <div style="display:flex; gap:10px; margin-top:24px; justify-content:flex-end;">
                <button type="button" class="btn-cancel"
                        onclick="closeModal('editModal')"
                        style="padding:10px 20px; border-radius:10px;
                               border:1px solid #ddd; font-weight:600; cursor:pointer;">
                    Cancel
                </button>
                <button type="submit" class="btn-primary"
                        style="padding:10px 20px; border-radius:10px;
                               border:none; font-weight:600; cursor:pointer;">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>


<!-- ═══════════════════════════════════
     SAVE CONFIRM MODAL
════════════════════════════════════ -->
<div id="saveModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-icon">💾</div>
        <div class="modal-title">Save Changes?</div>
        <div class="modal-msg">You are about to update:</div>
        <div class="modal-name" id="save-company-name"></div>
        <div class="modal-msg">Are you sure you want to save these changes?</div>
        <div class="modal-btns">
            <button class="btn-cancel"  onclick="closeModal('saveModal')">Cancel</button>
            <button class="btn-primary" onclick="submitSave()">Yes, Save</button>
        </div>
    </div>
</div>


<!-- ═══════════════════════════════════
     DELETE CONFIRM MODAL
════════════════════════════════════ -->
<div id="deleteModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-icon">🗑️</div>
        <div class="modal-title">Delete Company?</div>
        <div class="modal-msg">You are about to permanently delete:</div>
        <div class="modal-name" id="delete-company-name"></div>
        <div class="modal-msg">This cannot be undone.</div>
        <div class="modal-btns">
            <button class="btn-cancel" onclick="closeModal('deleteModal')">Cancel</button>
            <button class="btn-danger" onclick="submitDelete()">Yes, Delete</button>
        </div>
    </div>
</div>


<!-- Hidden forms -->
<form id="deleteForm" method="post" action="/Dash/DeleteCompany" style="display:none;">
    <input type="hidden" id="delete-id" name="id" />
</form>

<form id="saveForm" method="post" action="/Dash/UpdateCompany" style="display:none;">
    <input type="hidden" name="RegId"       id="sf-regid" />
    <input type="hidden" name="ClientName"  id="sf-clientname" />
    <input type="hidden" name="Phone"       id="sf-phone" />
    <input type="hidden" name="Address"     id="sf-address" />
    <input type="hidden" name="City"        id="sf-city" />
    <input type="hidden" name="CompanyName" id="sf-companyname" />
    <input type="hidden" name="CompanyType" id="sf-companytype" />
    <input type="hidden" name="Employees"   id="sf-employees" />
    <input type="hidden" name="UserId"      id="sf-userid" />
</form>


<script>
    /* ── Accordion ── */
    function toggleSlot(index) {
        const body  = document.getElementById('body-'  + index);
        const arrow = document.getElementById('arrow-' + index);
        const isOpen = body.classList.contains('open');

        document.querySelectorAll('.slot-body').forEach(b  => b.classList.remove('open'));
        document.querySelectorAll('.slot-arrow').forEach(a => a.classList.remove('open'));

        if (!isOpen) {
            body.classList.add('open');
            arrow.classList.add('open');
        }
    }

    /* ── Modal helpers ── */
    function openModal(id)  { document.getElementById(id).style.display = "flex"; }
    function closeModal(id) { document.getElementById(id).style.display = "none"; }

    document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', function(e) {
            if (e.target === this) closeModal(this.id);
        });
    });

    /* ── Edit ── */
    function openEdit(regId, clientName,  phone, address, city,
                      companyName, companyType, employees, userId) {
        document.getElementById('edit-regid').value       = regId;
        document.getElementById('edit-clientname').value  = clientName;
        document.getElementById('edit-phone').value       = phone;
        document.getElementById('edit-address').value     = address;
        document.getElementById('edit-city').value        = city;
        document.getElementById('edit-companyname').value = companyName;
        document.getElementById('edit-companytype').value = companyType;
        document.getElementById('edit-employees').value   = employees;
        document.getElementById('edit-userid').value      = userId;
        document.getElementById('edit-subtitle').textContent = 'Editing: ' + companyName;
        openModal('editModal');
    }

    /* ── Save confirm ── */
    function confirmSave(e) {
        e.preventDefault();
        const name = document.getElementById('edit-companyname').value;
        document.getElementById('save-company-name').textContent = name;

        document.getElementById('sf-regid').value       = document.getElementById('edit-regid').value;
        document.getElementById('sf-clientname').value  = document.getElementById('edit-clientname').value;
        document.getElementById('sf-phone').value       = document.getElementById('edit-phone').value;
        document.getElementById('sf-address').value     = document.getElementById('edit-address').value;
        document.getElementById('sf-city').value        = document.getElementById('edit-city').value;
        document.getElementById('sf-companyname').value = name;
        document.getElementById('sf-companytype').value = document.getElementById('edit-companytype').value;
        document.getElementById('sf-employees').value   = document.getElementById('edit-employees').value;
        document.getElementById('sf-userid').value      = document.getElementById('edit-userid').value;

        closeModal('editModal');
        openModal('saveModal');
        return false;
    }

    function submitSave() {
        document.getElementById('saveForm').submit();
    }

    /* ── Delete ── */
    function showDelete(id, name) {
        document.getElementById('delete-id').value = id;
        document.getElementById('delete-company-name').textContent = name;
        openModal('deleteModal');
    }

    function submitDelete() {
        document.getElementById('deleteForm').submit();
    }

    /* ── SweetAlert toasts ── */
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: '@TempData["SuccessMessage"]',
            timer: 2000,
            showConfirmButton: false,
            timerProgressBar: true
        });
        </text>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>
        Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: '@TempData["ErrorMessage"]',
            timer: 2000,
            showConfirmButton: false
        });
        </text>
    }






let addFormOpen = false;

function toggleAddForm() {
    const panel = document.getElementById('addCompanyPanel');
    addFormOpen = !addFormOpen;

    if (addFormOpen) {
        panel.classList.add('open');
        // scroll to very top so user sees it slide in
        window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
        panel.classList.remove('open');
        clearAddForm();
        document.getElementById('addCompanyError').style.display = 'none';
    }
}

function submitAddCompany() {
    const btn      = document.getElementById('addCompanyBtn');
    const errorBox = document.getElementById('addCompanyError');

    const clientName  = document.getElementById('add-clientname').value.trim();
    const phone       = document.getElementById('add-phone').value.trim();
    const city        = document.getElementById('add-city').value.trim();
    const address     = document.getElementById('add-address').value.trim();
    const companyName = document.getElementById('add-companyname').value.trim();
    const companyType = document.getElementById('add-companytype').value;
    const employees   = document.getElementById('add-employees').value.trim();
    const userId      = document.getElementById('add-userid').value.trim();

    if (!clientName || !phone || !city || !address || !companyName || !companyType || !employees) {
        errorBox.textContent = '⚠️ Please fill in all required fields.';
        errorBox.style.display = 'block';
        return;
    }

    errorBox.style.display = 'none';
    btn.disabled    = true;
    btn.textContent = 'Adding...';

    const formData = new FormData();
    formData.append('ClientName',  clientName);
    formData.append('Phone',       phone);
    formData.append('City',        city);
    formData.append('Address',     address);
    formData.append('CompanyName', companyName);
    formData.append('CompanyType', companyType);
    formData.append('Employees',   employees);
    formData.append('UserId',      userId);

    fetch('/Registration/Add', {
        method: 'POST',
        body: formData
    })
    .then(response => {
        if (response.redirected || response.ok) {

            // 1. Slide the form back up first
            toggleAddForm();

            // 2. Then show toast and reload
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: 'Company added successfully!',
                timer: 1500,
                showConfirmButton: false,
                timerProgressBar: true
            }).then(() => location.reload());

        } else {
            errorBox.textContent = '❌ Something went wrong. Please try again.';
            errorBox.style.display = 'block';
        }
    })
    .catch(() => {
        errorBox.textContent = '❌ Network error. Please try again.';
        errorBox.style.display = 'block';
    })
    .finally(() => {
        btn.disabled    = false;
        btn.textContent = '＋ Add Company';
    });
}

function clearAddForm() {
    ['add-clientname','add-phone','add-city','add-address',
     'add-companyname','add-companytype','add-employees','add-userid']
        .forEach(id => document.getElementById(id).value = '');
}

