@* @{
    ViewData["Title"] = "My Website - WebNest";
    var userName  = Context.Session.GetString("UserName");
    var userEmail = Context.Session.GetString("UserEmail");
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --primary-blue:   #1E3A8A;
        --primary-indigo: #3B5BDB;
        --primary-purple: #7C3AED;
        --gradient-main:  linear-gradient(90deg, #1E3A8A, #3B5BDB, #7C3AED);
    }


        /* ADD THIS */
    #addCompanyPanel {
        max-width: 800px;
        margin: 0 auto;
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        transition: max-height 0.55s ease, opacity 0.4s ease, margin-bottom 0.4s ease;
    }

    #addCompanyPanel.open {
        max-height: 800px;
        opacity: 1;
        margin-bottom: 24px;
    }



    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: var(--gradient-main);
        min-height: 100vh;
        padding: 40px 20px;
    }

    .welcome-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        margin: 0 auto 30px auto;
        max-width: 800px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        text-align: center;
    }

    .btn-action {
        background: var(--primary-indigo);
        color: white;
        border-radius: 30px;
        padding: 10px 30px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-top: 10px;
        font-size: 14px;
    }

    .btn-action:hover { background: var(--primary-purple); color: white; }

    .slots-container {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .company-slot {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0,0,0,0.12);
    }

    .slot-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
        cursor: pointer;
        user-select: none;
        transition: background 0.2s;
    }

    .slot-header:hover { background: #f5f7ff; }

    .slot-header-left { display: flex; align-items: center; gap: 14px; }

    .slot-number {
        width: 36px; height: 36px;
        border-radius: 50%;
        background: var(--gradient-main);
        color: white; font-weight: 700; font-size: 15px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .slot-title    { font-weight: 600; color: var(--primary-blue); font-size: 15px; }
    .slot-subtitle { font-size: 12px; color: #999; margin-top: 2px; }

    .slot-header-right { display: flex; align-items: center; gap: 10px; }

    .slot-arrow {
        font-size: 20px;
        color: var(--primary-indigo);
        transition: transform 0.3s ease;
    }

    .slot-arrow.open { transform: rotate(180deg); }

    .slot-body {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease;
        border-top: 0px solid #eee;
    }

    .slot-body.open { max-height: 700px; border-top: 1px solid #eee; }

    .slot-body-inner { padding: 20px 24px 24px; }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: 14px;
    }

    .detail-row:last-child { border-bottom: none; }

    .detail-label { color: #888; font-weight: 500; min-width: 140px; }
    .detail-value { color: var(--primary-blue); font-weight: 600; text-align: right; }

    .limit-note {
        text-align: center; color: white;
        font-size: 13px; margin-top: 16px; opacity: 0.85;
    }

    .btn-edit-slot {
        background: #3B82F6; color: white;
        border: none; border-radius: 8px;
        padding: 6px 14px; font-size: 13px;
        font-weight: 600; cursor: pointer;
    }

    .btn-delete-slot {
        background: #ef4444; color: white;
        border: none; border-radius: 8px;
        padding: 6px 14px; font-size: 13px;
        font-weight: 600; cursor: pointer;
    }

    /* ── Confirm / Edit Modals ── */
    .modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.5); z-index: 9999;
        align-items: center; justify-content: center;
    }

    .modal-box {
        background: white; border-radius: 18px;
        padding: 32px 28px; width: 90%; max-width: 440px;
        text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    }

    .modal-icon  { font-size: 42px; margin-bottom: 12px; }
    .modal-title { font-size: 20px; font-weight: 700; color: #1E3A8A; margin-bottom: 8px; }
    .modal-msg   { color: #555; font-size: 15px; margin-bottom: 16px; line-height: 1.5; }

    .modal-name {
        font-weight: 700; color: #1E3A8A;
        background: #eef2ff; padding: 2px 12px;
        border-radius: 8px; display: inline-block; margin-bottom: 16px;
    }

    .modal-btns { display: flex; gap: 12px; justify-content: center; margin-top: 8px; }

    .modal-btns button {
        padding: 10px 28px; border-radius: 10px;
        font-weight: 600; font-size: 15px; cursor: pointer; border: none;
    }

    .btn-cancel  { background: #f3f4f6; color: #333; }
    .btn-danger  { background: #ef4444; color: white; }
    .btn-primary { background: #3B82F6; color: white; }

    /* Edit modal wider */
    .edit-modal-box {
        background: white; border-radius: 18px;
        padding: 30px; width: 90%; max-width: 550px;
        max-height: 90vh; overflow-y: auto;
        box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    }

    .edit-field label {
        font-weight: 600; font-size: 13px; color: #555; display: block; margin-bottom: 4px;
    }

    .edit-field input {
        width: 100%; padding: 10px; border: 1px solid #ddd;
        border-radius: 8px; box-sizing: border-box; font-size: 14px;
    }
</style>





<!-- ═══════════════════════════════════
     ADD COMPANY SLIDE-DOWN FORM
════════════════════════════════════ -->
<div id="addCompanyPanel">


    <div style="
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    ">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <div>
                <h3 style="color:#1E3A8A; margin:0; font-weight:700;">Add New Company</h3>
                <p style="color:#888; font-size:13px; margin:4px 0 0;">Fill in the details below</p>
            </div>
            <button onclick="toggleAddForm()"
                    style="background:none; border:none; font-size:22px;
                           cursor:pointer; color:#999; line-height:1;">✕</button>
        </div>

        <!-- Error box -->
        <div id="addCompanyError"
             style="display:none; background:#fef2f2; color:#dc2626;
                    border-radius:8px; padding:10px 14px;
                    font-size:13px; margin-bottom:16px;">
        </div>

        <!-- Form Grid -->
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">

            <div class="edit-field">
                <label>Client Name</label>
                <input type="text" id="add-clientname" placeholder="Client Name" />
            </div>

            <div class="edit-field">
                <label>Phone</label>
                <input type="text" id="add-phone" placeholder="Phone" />
            </div>

            <div class="edit-field">
                <label>City</label>
                <input type="text" id="add-city" placeholder="City" />
            </div>

            <div class="edit-field">
                <label>Address</label>
                <input type="text" id="add-address" placeholder="Address" />
            </div>

            <div class="edit-field">
                <label>Company Name</label>
                <input type="text" id="add-companyname" placeholder="Company Name" />
            </div>

            <div class="edit-field">
                <label>Company Type</label>
                <select id="add-companytype"
                        style="width:100%; padding:10px; border:1px solid #ddd;
                               border-radius:8px; font-size:14px; color:#333;">
                    <option value="">-- Select Type --</option>
                    <option value="IT">IT (Software / Tech)</option>
                    <option value="E-commerce">E-commerce</option>
                    <option value="Education">Education</option>
                    <option value="Healthcare">Healthcare</option>
                    <option value="Finance">Finance / Banking</option>
                    <option value="Manufacturing">Manufacturing</option>
                    <option value="Retail">Retail / Shopping</option>
                    <option value="Real Estate">Real Estate</option>
                    <option value="Construction">Construction</option>
                    <option value="Agricultural">Agricultural</option>
                    <option value="Industrial">Industrial</option>
                    <option value="Transport">Transport / Logistics</option>
                    <option value="Media">Media / Marketing</option>
                    <option value="Government">Government</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="edit-field">
                <label>Employees</label>
                <input type="text" id="add-employees" placeholder="Number of Employees" />
            </div>

            <div class="edit-field">
                <label>User ID</label>
                <input type="text" id="add-userid" placeholder="User ID" />
            </div>

        </div>

        <!-- Buttons -->
        <div style="display:flex; gap:10px; margin-top:24px; justify-content:flex-end;">
            <button onclick="toggleAddForm()"
                    style="padding:10px 24px; border-radius:10px; border:1px solid #ddd;
                           font-weight:600; cursor:pointer; background:#f3f4f6; color:#333;">
                Cancel
            </button>
            <button id="addCompanyBtn" onclick="submitAddCompany()"
                    style="padding:10px 24px; border-radius:10px; border:none;
                           font-weight:600; cursor:pointer;
                           background: var(--gradient-main); color:white;">
                ＋ Add Company
            </button>
        </div>
    </div>
</div>







<!-- Welcome Card -->
<div class="welcome-card">
    <h2 style="color: var(--primary-indigo); font-weight: 700;">Welcome, @userName! 👋</h2>
    <p style="color: #666; margin-top: 6px;">Email: @userEmail</p>
    <p style="color: #999; font-size: 13px; margin-top: 4px;">
        You have <strong style="color: var(--primary-indigo);">@ViewBag.CompanyCount</strong> / 5 companies registered.
    </p>

    @if (ViewBag.CompanyCount < 5)
    {
            <button class="btn-action" onclick="toggleAddForm()">+ Add Company</button>   
    }
    else
    {
        <button class="btn-action" style="background:#aaa; cursor:not-allowed;" disabled>
            Max 5 Companies Reached
        </button>
    }

    <a href="/Login/Login" class="btn-action" style="margin-left:10px;">Logout</a>
</div>


<!-- Company Slots -->
@if (ViewBag.Companies != null && ViewBag.CompanyCount > 0)
{
    <div class="slots-container">
        @{ int counter = 1; }

        @foreach (var company in ViewBag.Companies)
        {
            <div class="company-slot">
                <div class="slot-header" onclick="toggleSlot(@counter)">
                    <div class="slot-header-left">
                        <div class="slot-number">@counter</div>
                        <div>
                            <div class="slot-title">@company.CompanyName</div>
                            <div class="slot-subtitle">@company.CompanyType &nbsp;|&nbsp; @company.City</div>
                        </div>
                    </div>
                    <div class="slot-header-right">
                        <button class="btn-edit-slot"
                                onclick="event.stopPropagation(); openEdit(
                                    @company.RegId,
                                    '@company.ClientName',
                                    '@company.Phone',
                                    '@company.Address',
                                    '@company.City',
                                    '@company.CompanyName',
                                    '@company.CompanyType',
                                    '@company.Employees',
                                    '@company.UserId')">
                            ✏️ Edit
                        </button>
                        <button class="btn-delete-slot"
                                onclick="event.stopPropagation();
                                         showDelete(@company.RegId, '@company.CompanyName')">
                            🗑️ Delete
                        </button>
                        <span class="slot-arrow" id="arrow-@counter">&#9662;</span>
                    </div>
                </div>

                <div class="slot-body" id="body-@counter">
                    <div class="slot-body-inner">
                        <div class="detail-row">
                            <span class="detail-label">Client Name</span>
                            <span class="detail-value">@company.ClientName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Phone</span>
                            <span class="detail-value">@company.Phone</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Address</span>
                            <span class="detail-value">@company.Address</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">City</span>
                            <span class="detail-value">@company.City</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Company Name</span>
                            <span class="detail-value">@company.CompanyName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Company Type</span>
                            <span class="detail-value">@company.CompanyType</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Employees</span>
                            <span class="detail-value">@company.Employees</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">User ID</span>
                            <span class="detail-value">@company.UserId</span>
                        </div>
                    </div>
                </div>
            </div>

            counter++;
        }
    </div>

    <p class="limit-note">&#9432; Maximum 5 companies allowed per account</p>
}




