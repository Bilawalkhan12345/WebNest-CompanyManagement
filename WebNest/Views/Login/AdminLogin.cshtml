@model WebNest.Models.Admin

@{
    ViewData["Title"] = "Admin Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
    --primary-blue: #1E3A8A;
    --primary-indigo: #3B5BDB;
    --primary-purple: #7C3AED;
    --gradient-main: linear-gradient(90deg, #1E3A8A, #3B5BDB, #7C3AED);
    }

    body {
    font-family: 'Segoe UI', sans-serif;
    background: var(--gradient-main);
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    }

    .login-card {
    background: white;
    padding: 40px;
    border-radius: 20px;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    .login-card h2 {
    text-align: center;
    font-weight: 700;
    color: var(--primary-indigo);
    margin-bottom: 25px;
    }

    .form-control {
    border-radius: 10px;
    padding: 10px;
    }

    .btn-login {
    background: var(--gradient-main);
    color: white;
    border: none;
    border-radius: 30px;
    padding: 10px;
    font-weight: 600;
    width: 100%;
    transition: 0.3s;
    }

    .btn-login:hover {
    opacity: 0.9;
    }

    .logo {
    display: block;
    margin: 0 auto 20px;
    height: 60px;
    }
</style>

<div class="login-card animate__animated animate__zoomIn">

    <img src="~/images/WebNest Logo.png" class="logo" />
    <h2>Admin Login</h2>

    <!-- ✅ FIXED: post to AdminLogin not CompDetails -->
    <form asp-action="AdminLogin" asp-controller="Login" method="post">

        <div class="mb-3">
            <label>Admin ID</label>
            <input asp-for="AdminId" class="form-control" placeholder="Enter Admin ID" />
            <span asp-validation-for="AdminId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Password</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Enter Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-login mt-2">Login</button>

    </form>

    <br />

    <div class="text-center">
        <a href="/Home/Index" class="text-decoration-none fw-semibold" style="color:#1E3A8A;">
            Go to Home page
        </a>
    </div>

</div>

<script>
    @if (TempData["AdminError"] != null)
    {
        <text>
            Swal.fire({
            icon: 'error',
            title: 'Login Failed',
            text: '@TempData["AdminError"]',
            timer: 2500,
            showConfirmButton: false
            });
        </text>
    }
</script>