@{
    ViewData["Title"] = "Login - WebNest";

}



<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    :root {
        --primary-blue: #1E3A8A;
        --primary-indigo: #3B5BDB;
        --primary-purple: #7C3AED;
        --gradient-main: linear-gradient(90deg, #1E3A8A, #3B5BDB, #7C3AED);
    }

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: var(--gradient-main);
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }

    .login-title {
        font-weight: 700;
        color: var(--primary-indigo);
    }

    .form-control {
        border-radius: 10px;
        padding: 10px;
    }

    .btn-login {
        background: var(--primary-indigo);
        color: white;
        border-radius: 30px;
        padding: 10px;
        font-weight: 600;
        width: 100%;
    }

        .btn-login:hover {
            background: var(--primary-purple);
        }

    .logo {
        height: 60px;
        margin-bottom: 15px;
    }

    .extra-links a {
        text-decoration: none;
        color: var(--primary-indigo);
        font-size: 0.9rem;
    }

        .extra-links a:hover {
            text-decoration: underline;
        }
</style>

<div class="login-card text-center">

    <!-- LOGO -->
    <img src="~/images/WebNest Logo.png" class="logo" alt="Logo">

    <h3 class="login-title mb-3">Welcome Back</h3>
    <p class="text-muted mb-4">Login to your Own Website account</p>

    <!-- FORM (UI ONLY) -->
    <form asp-action="Login" method="post">

        <div class="mb-3 text-start">
            <label>Enter user name</label>
            <input type="text" class="form-control" placeholder="Enter your user ID" name="Email">
        </div>

        <div class="mb-3 text-start">
            <label>Password</label>
            <input type="password" class="form-control" placeholder="Enter your password" name="Password">
        </div>

        <div class="d-flex justify-content-between mb-3 extra-links">
            <a href="#">Forgot Password?</a>
        </div>

        <button type="submit" class="btn btn-login">Login</button>

    </form>

        <div class="small-text text-center">
        <a href="/Login/Signup"
               class="text-decoration-none fw-semibold"
               style="color:#1E3A8A;">
            Don't have an account? Sign up
        </a>
    </div>


    <br />

    <div class="small-text text-center">
        <a href="/Home/Index"
               class="text-decoration-none fw-semibold"
               style="color:#1E3A8A;">
            Go to Home page
        </a>
    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
        icon: 'error',
        title: 'Login Failed',
        text: '@TempData["Error"]',
        timer: 2000,
        showConfirmButton: false,
        timerProgressBar: true
        });
    </script>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
        icon: 'success',
        title: 'Success',
        text: '@TempData["Success"]',
        timer: 1000,
        showConfirmButton: false,
        timerProgressBar: true,
        willClose: () => {
        @* window.location.href = '/Dash/Dashboard'; *@
        }
        });
    </script>
}