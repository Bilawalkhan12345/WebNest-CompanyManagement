@model WebNest.Models.Signup

@{
    ViewData["Title"] = "Signup - WebNest";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    :root {
        --primary-blue: #1E3A8A;
        --primary-indigo: #3B5BDB;
        --primary-purple: #7C3AED;
        --gradient-main: linear-gradient(90deg, #1E3A8A, #3B5BDB, #7C3AED);
    }

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: var(--gradient-main);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
    }

    .login-title {
        font-weight: 700;
        color: var(--primary-indigo);
    }

    .form-control {
        border-radius: 10px;
        padding: 10px;
    }

    .btn-login {
        background: var(--primary-indigo);
        color: white;
        border-radius: 30px;
        padding: 10px;
        font-weight: 600;
        width: 100%;
    }

        .btn-login:hover {
            background: var(--primary-purple);
        }

    .logo {
        height: 60px;
        margin-bottom: 15px;
    }

    .extra-links a {
        text-decoration: none;
        color: var(--primary-indigo);
        font-size: 0.9rem;
    }

        .extra-links a:hover {
            text-decoration: underline;
        }
</style>

<div class="login-card text-center">

    <!-- LOGO -->
    <img src="~/images/WebNest Logo.png" class="logo" alt="Logo">

    <h3 class="login-title mb-3">Create Account</h3>
    <p class="text-muted mb-4">Signup to get started</p>

    <!-- FORM -->
    <form asp-action="Signup" asp-controller="Login" method="post">

        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="mb-3 text-start">
            <label>First Name</label>
            <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="mb-3 text-start">
            <label>Last Name</label>
            <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="mb-3 text-start">
            <label>Email</label>
            <input asp-for="Email" class="form-control" placeholder="Enter email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3 text-start">
            <label>Password</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3 text-start">
            <label>Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-login">Signup</button>

    </form>

    <br />

    <div class="small-text text-center">
        <a href="/Login/Login"
               class="text-decoration-none fw-semibold"
               style="color:#1E3A8A;">
            Already have an account? Login
        </a>
    </div>

<br />

    <div class="small-text text-center">
        <a href="/Home/Index"
               class="text-decoration-none fw-semibold"
               style="color:#1E3A8A;">
            Go to Home page
        </a>
    </div>



</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
        icon: 'success',
        title: 'Success',
        text: '@TempData["Success"]',
        timer: 1500,
        showConfirmButton: false,
        timerProgressBar: true
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
        icon: 'error',
        title: 'Error',
        text: '@TempData["Error"]',
        timer: 2000,
        showConfirmButton: false
        });
    </script>
}